# 复制成 local.env 再按自己的环境改。local.env 不进 git。
#
# 这个 skill 不绑定具体的 AI。你用哪个 CLI 当子 agent，就在这里写怎么调用它。
# 子 agent 分两种：
#   主力子 agent：有沙箱，能只读，也能写工作目录。读资料、写代码、验证都用它。必需。
#   轻量子 agent：额度少或者没有沙箱，只接小活。可选，没有时小活也给主力子 agent。
#
# 下面的 my-agent 和 my-light-agent 换成你的 CLI，参数只是示意，按它的帮助文档改。
# 函数体里用 exec：这样外层的超时能直接作用到 CLI 上。

# ---- 主力子 agent ----------------------------------------------------------

# 模型默认用最新的，而且不要在这里写死型号：写死的型号每出一代新模型就过时一次，
# 主路由照着旧名派工也发现不了。改成定义 worker_latest_model，让它从 CLI 自己的模型列表
# 现查最新型号，打印一行型号名。WORKER_MODEL 为空时，派工脚本会调它。
# 查不到就什么都不打印，这时用 CLI 自己的默认模型。不定义这个函数也行，效果一样。
# 强度写在这里，主路由选的时候会看：low、medium、high（按你的 CLI 改）。
WORKER_MODEL="${WORKER_MODEL:-}"
# worker_latest_model() {
#   my-agent models --json | <按版本号挑出最新的主力型号，打印它的名字>
# }

# 跑一轮。参数：沙箱模式（read-only 或 workspace-write）、工作目录、结果文件、JSON schema 文件（可空）。
# 提示词从标准输入读。最后一条消息写进结果文件，日志打到标准输出。
# 模型和强度在 WORKER_MODEL、WORKER_EFFORT 里，都可能为空。
worker_run() {
  local mode="$1" work="$2" result="$3" schema="$4"
  exec my-agent --sandbox "$mode" --cd "$work" --output "$result" \
    ${WORKER_MODEL:+--model "$WORKER_MODEL"} \
    ${WORKER_EFFORT:+--effort "$WORKER_EFFORT"} \
    ${schema:+--schema "$schema"}
}

# 把反馈交回同一个会话继续。参数：会话 id、反馈文字、结果文件。在工作目录里执行。
# 你的 CLI 不支持续接就删掉这个函数和下面的 worker_session_id，
# 脚本会开新一轮，把原派工单和反馈一起发过去。
worker_resume() {
  local session="$1" message="$2" result="$3"
  exec my-agent --resume "$session" --output "$result" \
    ${WORKER_MODEL:+--model "$WORKER_MODEL"} \
    ${WORKER_EFFORT:+--effort "$WORKER_EFFORT"} \
    "$message"
}

# 从一轮的日志里取会话 id。参数：日志文件。
worker_session_id() {
  grep -m1 -oE 'session id: [0-9a-f-]+' "$1" | awk '{print $3}'
}

# 代提交时的作者。
# IMPL_AUTHOR="${IMPL_AUTHOR:-Sub-agent <sub-agent@local>}"

# ---- 轻量子 agent（可选，不用就删掉 light_run）--------------------------------

# 和主力子 agent 一样，型号不写死：LIGHT_MODEL 为空时，脚本调 light_latest_model 现查最新的。
# light_latest_model() {
#   my-light-agent models | <按版本号挑出最新的型号，打印它的名字>
# }
# 做不好时换的更强模型（可选）。没有强度档位的 CLI，换模型就是换强度。
# LIGHT_STRONG_MODEL="${LIGHT_STRONG_MODEL:-my-strong-light-model}"
# 单日最多调用几次，按自己的套餐定。
# LIGHT_DAILY_MAX="${LIGHT_DAILY_MAX:-8}"

# 跑一轮。参数：提示词文件。在工作目录里执行。输出打到标准输出，错误打到标准错误。
light_run() {
  exec my-light-agent ${LIGHT_MODEL:+--model "$LIGHT_MODEL"} --prompt "$(cat "$1")"
}

# 从输出里取最后一条回答（可选，不定义时整份输出就是回执）。参数：输出文件、回执文件。
# light_receipt() { tail -1 "$1" > "$2"; }

# 数工具调用了几次，记进账本（可选）。参数：输出文件。
# light_tool_count() { grep -c 'tool_call' "$1"; }
